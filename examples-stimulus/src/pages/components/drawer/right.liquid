{% layout "templates/layout.liquid" %}
{% block %}
<!-- #region body -->
<div data-controller="invoke">
<button class="x-button" data-action="click->invoke#action" data-invoke-action="x-drawer#show" data-invoke-target="#drawerRightElement" aria-controls="drawerRightElement" aria-expanded="false">Show drawer</button>
<dialog data-controller="x-drawer" class="x-drawer" style="animation-direction: reverse" id="drawerRightElement" closedby="any" data-x-drawer-placement-value="right">
    <div class="x-drawer-scroller after:order-first snap-x snap-mandatory">
        <nav class="x-drawer-content" data-x-drawer-target="content">
            Drawer content
            <button class="x-button muted" data-action="click->x-drawer#close">Close drawer</button>
        </nav>
    </div>
</dialog>
</div>
<!-- #endregion body -->
{% endblock %}


