{% layout "templates/layout.liquid" %}
{% block %}
<!-- #region body -->
<button class="x-button" data-controller="x-button" interestfor="popoverInterest">Popover</button>
<div class="x-popover bottom my-2" data-controller="x-popover" popover="hint" id="popoverInterest">
    <div class="x-popover-content shadow dark:bg-body-secondary p-2 w-32 flex flex-col">
        <button class="x-button ghosted accent-main justify-start w-full" data-controller="x-button">Item 1</button>
        <button class="x-button ghosted accent-main justify-start w-full" data-controller="x-button">Item 2</button>
    </div>
</div>
<!-- #endregion body -->
{% endblock %}
