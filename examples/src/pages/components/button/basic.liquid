{% layout "templates/layout.liquid" %}
{% block %}
<button class="x-button" is="x-button">Button</button>
<a class="x-button rounded-full" href="#" is="x-button-a">Button</a>
{% endblock %}

{% block foot %}
<!-- #region js -->
<script type="module">
    import '@webreflection/custom-elements-builtin'
    import { Button } from 'winduum-elements/components/button/index.js'

    customElements.define('x-button', Button(HTMLButtonElement), { extends: 'button' })
    customElements.define('x-button-a', Button(HTMLAnchorElement), { extends: 'a' })
</script>
<!-- #endregion js -->
{% endblock %}
