{% layout "templates/layout.liquid" %}
{% block %}
<details class="x-details group bg-body-secondary p-4 rounded">
    <summary class="w-fit flex">
        <label class="x-check">
            <input type="checkbox" data-action="toggleDetailsCheckbox" autocomplete="off">
            Fill more
        </label>
    </summary>
    <div>
        <div class="x-control max-w-96 mt-4">
            <input>
        </div>
    </div>
</details>
{% endblock %}

{% block head %}
<style>
  body {
    flex-direction: column;
    gap: 1rem;
  }

  details {
    width: 100%;
  }
</style>
{% endblock %}

{% block foot %}
<!-- #region js -->
<script type="module">
    document.querySelectorAll('[data-action="toggleDetailsCheckbox"]').forEach(input => {
        input.addEventListener('change', ({ target }) => {
            target.closest('details').toggleAttribute('open', target.checked)
        })
    })
</script>
<!-- #endregion js -->
{% endblock %}
