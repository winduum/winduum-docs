{% layout "templates/layout.liquid" %}
{% block %}
<details class="x-details group bg-body-secondary p-4 rounded-md" is="x-details">
    <summary class="w-fit flex">
        <label class="x-check">
            <input type="checkbox" autocomplete="off">
            Fill more
        </label>
    </summary>
    <div class="x-control max-w-96 mt-4">
        <input>
    </div>
</details>
{% endblock %}

{% block head %}
<style>
  body {
    flex-direction: column;
    gap: 1rem;
  }

  details {
    width: 100%;
  }
</style>
{% endblock %}

{% block foot %}
<!-- #region js -->
<script type="module">
    import { supportsIs } from 'webuum/supports'
    import { Details } from 'winduum-elements/components/details/index.js'

    if (!supportsIs()) {
        await import('@webreflection/custom-elements-builtin')
    }

    customElements.define('x-details', Details, { extends: 'details' })
</script>
<!-- #endregion js -->
{% endblock %}
