{% layout "templates/layout.liquid" %}
{% block %}
    <div class="w-full flex flex-col items-center">
        <button class="x-button" command="toggle-popover" commandfor="popoverApi" aria-controls="popoverApi">Popover</button>
        <x-popover class="x-popover bottom my-2" popover id="popoverApi" data-placement="bottom">
            <div class="x-popover-content shadow dark:bg-body-secondary p-2">
                <input type="text">
            </div>
        </x-popover>
    </div>
{% endblock %}

{% block head %}
<style>
  .dark\:bg-body-secondary {
    background-color: var(--color-body-secondary) !important;
  }
</style>
{% endblock %}

{% block foot %}
<!-- #region js -->
<script type="module">
    import { Popover } from 'winduum-elements/components/popover/index.js'

    customElements.define('x-popover', Popover)

    if (!('command' in HTMLButtonElement.prototype)) {
        const { apply } = await import('invokers-polyfill/fn')
        apply()
    }
</script>
<!-- #endregion js -->
{% endblock %}
