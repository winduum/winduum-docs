{% layout "templates/layout.liquid" %}
{% block %}
<button class="x-button" id="showToast">Show toast</button>

<ol class="x-toaster items-end" popover="manual"></ol>
{% endblock %}

{% block foot %}
<!-- #region js -->
<script type="module">
    import { showToast, closeToast } from 'winduum/src/components/toast/index.js'
    import { toasterObserver } from 'winduum/src/components/toaster/index.js'

    const toaster = document.querySelector('.x-toaster')

    toasterObserver().observe(toaster, { childList: true })

    document.querySelector('#showToast').addEventListener('click', () => {
        toaster.insertAdjacentHTML('beforeend', `
            <li class="x-toast" role="status" aria-live="assertive" aria-atomic="true">
                <div class="x-toast-content">
                    <div class="flex-col">
                        <div class="x-title">Hello toast</div>
                        <div class="x-text">Amazing toast</div>
                    </div>
                    <button class="x-button muted ml-auto" data-action="closeToast">Close</button>
                </div>
            </li>
        `)

        showToast(toaster.lastElementChild)
    })

    document.addEventListener('click', ({ target }) => {
        if (target.matches('[data-action="closeToast"]')) {
            closeToast(target.closest('.x-toast'))
        }
    })
</script>
<!-- #endregion js -->
{% endblock %}
