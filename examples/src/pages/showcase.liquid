{% layout "templates/layout.liquid" %}
{% block %}
<button class="x-button">Button</button>
<button class="x-button bordered">Button</button>
<div class="x-badge accent-success rounded-full">Badge</div>
<div class="x-tooltip tooltip-bottom" aria-label="I am tooltip">
    <button class="x-button muted">Tooltip</button>
</div>
<div class="x-switch">
    <input type="checkbox" checked aria-label="Switch">
    Switch
</div>
<div class="x-check">
    <input type="checkbox" checked aria-label="Checkbox">
    Checkbox
</div>
<div class="x-rating accent-warning">
    <input type="radio" name="rating" value="1" aria-label="Rate 1/5">
    <input type="radio" name="rating" value="2" aria-label="Rate 2/5">
    <input type="radio" name="rating" value="3" checked aria-label="Rate 3/5">
    <input type="radio" name="rating" value="4" aria-label="Rate 4/5">
    <input type="radio" name="rating" value="5" aria-label="Rate 5/5">
</div>
<div class="x-range" style="max-width: 10rem">
    <input type="range" value="50" step="10" max="100" min="0" aria-label="Range">
</div>
<progress class="x-progress accent-primary" value="66" max="100" style="max-width: 10rem"></progress>
{% endblock %}
